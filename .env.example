# ─────────── Режим работы ───────────
# dry_run — ничего наружу не уходит, всё только в лог. Начинать отсюда.
# shadow  — сотрудникам в группы пишем, клиентам нет.
# assist  — ПОЛУАВТОМАТ: бот клиентам не отвечает, а складывает обращения
#           карточками в группу. Сотрудники отвечают из группы, бот доставляет.
# live    — боевой режим, бот отвечает сам.
MODE=dry_run

# ─────────── Linko ───────────
LINKO_BASE_URL=https://sfademo.linko.uz
LINKO_TOKEN=

# ─────────── Telegram ───────────
# Создать бота: @BotFather → /newbot
# Затем обязательно: /mybots → бот → Bot Settings → Secretary Mode → включить
# (до мая 2026 назывался Business Mode — это одно и то же)
BOT_TOKEN=

# ID групп сотрудников. Узнать: добавить бота в группу и написать /chatid
# У групп ID отрицательный, например -1001234567890
ACCOUNTANT_CHAT_ID=
FINANCE_CHAT_ID=
MANAGER_CHAT_ID=

# Группа для полуавтомата: сюда падают обращения клиентов
ASSIST_CHAT_ID=

# ─────────── Канал A: Telegram Business ───────────
# Белый список чатов на время пилота (через запятую).
# Пусто = бот отвечает всем, кого пропускают настройки Business в аккаунте.
BUSINESS_ALLOWLIST=

# Чаты, где бот не отвечает никогда — личная переписка владельца.
BUSINESS_BLOCKLIST=

# ─────────── Искусственный Интеллект (LLM) ───────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ─────────── База Данных & Сервер ───────────
# pglite://.data/akm — встроенная база в файле, работает сразу без внешнего сервера.
# Для удалённого Postgres: postgres://user:password@host:port/dbname
DATABASE_URL=pglite://.data/akm

# Порт для Health Check (на Replit/Render задаётся автоматически через $PORT)
PORT=3000

SYNC_INTERVAL_SEC=120
TZ_OFFSET_HOURS=5
LOG_LEVEL=info

